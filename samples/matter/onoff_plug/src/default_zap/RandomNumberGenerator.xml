<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configurator>
  <cluster>
    <domain>General</domain>
    <name>RandomNumberGenerator</name>
    <code>0xfff1fc01</code>
    <define>RANDOM_NUMBER_GENERATOR</define>
    <description>A cluster for generating random numbers</description>
    <attribute name="GeneratedNumber" side="server" code="0xfff10000" define="GENERATED_NUMBER" type="int16s" min="-32768" max="32767"/>
    <command name="Generate" code="0xfff10000" source="client" response="GenerateResponse">
      <description>Command that triggers random number generation and returns the number. Additionally it uses arguments that define min and max range of generation.</description>
      <arg name="MinValue" type="int16s" min="-32768" max="32767"/>
      <arg name="MaxValue" type="int16s" min="-32768" max="32767"/>
    </command>
    <event name="NumberGenerated" code="0xfff10000" side="server" priority="info">
      <description>Event is generated once the new number is generated</description>
    </event>
  </cluster>
  <deviceType>
    <name>random-number-generator</name>
    <typeName>Random number generator</typeName>
    <domain>CHIP</domain>
    <class>Simple</class>
    <scope>Endpoint</scope>
    <profileId editable="false">0x104</profileId>
    <deviceId editable="false">0xfff10001</deviceId>
    <clusters lockOthers="true">
      <include cluster="RandomNumberGenerator" server="true"/>
    </clusters>
  </deviceType>
</configurator>